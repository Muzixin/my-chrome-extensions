{
  "manifest_version": 3,
  "name": "Immersive Lite — 极简沉浸式翻译",
  "version": "0.1.0",
  "description": "网页右侧悬浮按钮,点击即整页双语沉浸式翻译。基于 Google 免费翻译接口,零配置、无商业元素。",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "翻译 / 还原本页",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://translate.googleapis.com/*"]
}
